 "cells": [
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "8aef9ff6-8c63-429e-9bba-d1b94f65a15c",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "from openpyxl import load_workbook\n",
    "from openpyxl.styles import PatternFill\n",
    "import re \n",
    "# Load the Excel file\n",
    "file_path = \...\"  # Replace with your file path\n",
    "data = pd.read_excel(file_path, na_filter=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "3e0b726d-458b-4bb0-a024-9b23faabdd0d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load the DMA dictionary file**\n",
    "dma_dict_path = \"..\"\n",
    "dma_dict = pd.read_excel(dma_dict_path)\n",
    "\n",
    "# Perform the DMA mapping**\n",
    "data[\"inputzipdma_recode\"] = data[\"inputzipdma_recode\"].astype(str).str.strip()\n",
    "dma_dict[\"inputzipdma_recode\"] = dma_dict[\"inputzipdma_recode\"].astype(str).str.strip()\n",
    "\n",
    "# Merge to add the `DMA` column based on matching `inputzidma_recode`\n",
    "data = data.merge(dma_dict, on=\"inputzipdma_recode\", how=\"left\")\n",
    "\n",
    "# Rename the mapped column to `DMA`\n",
    "data.rename(columns={\"code\": \"DMA\"}, inplace=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "9f1feb6b-2b83-4789-8011-b85c6412c9ed",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Backup the original columns at the start of the script\n",
    "original_columns = data[[\n",
    "    'Carmax2022_specretail_Q1_open1', 'Carmax2022_specretail_Q1_open2', 'Carmax2022_specretail_Q1_open3',\n",
    "    'Carmax2022_online_Q1_open1', 'Carmax2022_online_Q1_open2', 'Carmax2022_online_Q1_open3'\n",
    "]].copy()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "708beb82-f13b-47f1-96cf-e5c9879cdcaa",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Add the internal flag column at the beginning\n",
    "data.insert(0, \"Internal_flag\", None)  "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "5a775376-1e74-4b94-a7a4-ca05fa8f197c",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Ensure the columns are in datetime format\n",
    "data[\"starttime\"] = pd.to_datetime(data[\"starttime\"], errors='coerce')\n",
    "data[\"endtime\"] = pd.to_datetime(data[\"endtime\"], errors='coerce')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "015cd6b3-66cf-4923-96ce-754174ed72bc",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Filter the DataFrame to keep only rows with dates required\n",
    "filtered_data = data[(data['endtime'] >= pd.to_datetime('04/18/2025')) & (data['endtime'] <= pd.to_datetime('04/25/2025'))]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "132feac3-35ab-404d-a983-52eb67a650da",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save the result to our Internal check file specifying dates\n",
    "filtered_data.to_excel('US26560581_CARMAX_2024-2025_Week of April 18 - 24,2025_Internal.xlsx', index=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "abfde097-ea5d-4294-b972-bca7752f800b",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define the columns to check\n",
    "columns_to_check = [\n",
    "    'Carmax2022_specretail_Q1_open1', 'Carmax2022_specretail_Q1_open2', 'Carmax2022_specretail_Q1_open3',\n",
    "    'Carmax2022_online_Q1_open1', 'Carmax2022_online_Q1_open2', 'Carmax2022_online_Q1_open3'\n",
    "]\n",
    "\n",
    "# Work with a copy of the DataFrame to avoid duplication and following Pandas caveats\n",
    "filtered_data = filtered_data.copy()\n",
    "\n",
    "# Normalize data \n",
    "stacked_normalized = (\n",
    "    filtered_data[columns_to_check]\n",
    "    .stack()  # Stack columns into a single series\n",
    "    .map(lambda x: str(x).strip().lower() if pd.notna(x) and str(x).strip() else None)  # Normalize values\n",
    ")\n",
    "\n",
    "# Counts from the normalized data\n",
    "value_counts = stacked_normalized.value_counts()\n",
    "\n",
    "# Map the counts back to the original columns in the DataFrame\n",
    "for col, count_col in zip(\n",
    "    columns_to_check,\n",
    "    ['OE Count 1.1', 'OE Count 1.2', 'OE Count 1.3', 'OE Count 2.1', 'OE Count 2.2', 'OE Count 2.3']\n",
    "):\n",
    "    filtered_data[count_col] = filtered_data[col].map(\n",
    "        lambda val: value_counts.get(str(val).strip().lower(), 0) if pd.notna(val) and str(val).strip() else 0\n",
    "    )\n",
    "\n",
    "# Save the result to our Internal check file specifying dates\n",
    "filtered_data.to_excel('US26560581_CARMAX_2024-2025_Week of April 18 - 24,2025_Internal.xlsx', index=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "4e526218-b6b8-4a54-af0b-6b704a08ce18",
   "metadata": {},
   "outputs": [],
   "source": [
    "# For the low freq column - Define the columns where the counts were added\n",
    "low_frequency_columns = [\n",
    "    'OE Count 1.1', 'OE Count 1.2', 'OE Count 1.3', \n",
    "    'OE Count 2.1', 'OE Count 2.2', 'OE Count 2.3'\n",
    "]\n",
    "\n",
    "# Add a new column to count low-frequency values (< 4)\n",
    "filtered_data['Count of Low Frequency'] = filtered_data[low_frequency_columns].apply(\n",
    "    lambda row: sum(val < 4 for val in row if pd.notna(val)), axis=1\n",
    ")\n",
    "\n",
    "# Save the result to the internal file, or hashout and continue \n",
    "filtered_data.to_excel('US26560581_CARMAX_2024-2025_Week of April 18 - 24,2025_Internal.xlsx', index=False)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "5dae2620-997e-4aa3-9583-b84e41069980",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define the keywords to count.. can keep on adding bag of words here or use the dictionary/glossary for this\n",
    "keywords = [\"walmart\", \"target\", \"amazon\", \"pros\", \"cons\", \"this\", \"shit\", \"Ikea\", \"ikea\", \"fuck\", \".\"]\n",
    "\n",
    "# Specify the columns to normalize and check\n",
    "columns_to_check = [\n",
    "    'Carmax2022_specretail_Q1_open1', 'Carmax2022_specretail_Q1_open2', 'Carmax2022_specretail_Q1_open3',\n",
    "    'Carmax2022_online_Q1_open1', 'Carmax2022_online_Q1_open2', 'Carmax2022_online_Q1_open3'\n",
    "]\n",
    "\n",
    "# Normalize data: replace NaN with empty strings, convert all values to strings, and apply lower case\n",
    "filtered_data[columns_to_check] = filtered_data[columns_to_check].fillna(\"\").apply(\n",
    "    lambda col: col.astype(str).str.lower()\n",
    ")\n",
    "\n",
    "# Count occurrences of keywords in each row across the specified columns\n",
    "filtered_data['Content'] = filtered_data[columns_to_check].apply(\n",
    "    lambda row: sum(cell.strip() in keywords for cell in row),\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "# Save \n",
    "filtered_data.to_excel('US26560581_CARMAX_2024-2025_Week of April 18 - 24,2025_Internal.xlsx', index=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "6700dc01-ae14-4cba-a2b9-8322d838eca7",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load the dictionary of words (words to check against)\n",
    "dictionary_path = \"C:/Users/muhammad.asad/OneDrive - YouGov Services Limited/Desktop/DataProcess Automation/CarMax/CarMax_Dictionary.xlsx\"\n",
    "dictionary_df = pd.read_excel(dictionary_path)\n",
    "\n",
    "# Get the list of words from the dictionary\n",
    "dictionary_words = dictionary_df['Words'].str.lower().tolist()  # Convert to lowercase\n",
    "\n",
    "# Specify the columns to normalize and check\n",
    "columns_to_check = [\n",
    "    'Carmax2022_specretail_Q1_open1', 'Carmax2022_specretail_Q1_open2', 'Carmax2022_specretail_Q1_open3'\n",
    "]\n",
    "\n",
    "# Normalize data: replace NaN with empty strings, convert all values to strings, and apply lower case\n",
    "filtered_data.loc[:, columns_to_check] = filtered_data[columns_to_check].fillna(\"\").apply(\n",
    "    lambda col: col.astype(str).str.lower()\n",
    ")\n",
    "\n",
    "# Define a function to count words in a row that are not in the dictionary\n",
    "def count_missing_words(row, dictionary_words):\n",
    "    missing_words = 0\n",
    "    for cell in row:\n",
    "        words_in_cell = cell.split()  # Split into words (space separated)\n",
    "        for word in words_in_cell:\n",
    "            if word not in dictionary_words:  # If word is not in the dictionary\n",
    "                missing_words += 1\n",
    "    return missing_words\n",
    "\n",
    "# Apply the function to each row across the specified columns and assign the result to Missing_Words_Count\n",
    "filtered_data.loc[:, 'Missing_Words_Count'] = filtered_data[columns_to_check].apply(\n",
    "    lambda row: count_missing_words(row, dictionary_words),\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "# Save the updated DataFrame to a new Excel file\n",
    "filtered_data.to_excel('US26560581_CARMAX_2024-2025_Week of April 18 - 24,2025_Internal.xlsx', index=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "b85be5d4-148f-424a-bbcb-609332196cb0",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Get the position of the column 'Carmax2022_online_Q1_open3'\n",
    "position = filtered_data.columns.get_loc('Carmax2022_online_Q1_open3')\n",
    "\n",
    "# List of new columns to add (OE counts, low frequency count, and content)\n",
    "new_columns = ['OE Count 1.1', 'OE Count 1.2', 'OE Count 1.3', 'OE Count 2.1', 'OE Count 2.2', 'OE Count 2.3', 'Count of Low Frequency', 'Content']\n",
    "\n",
    "# Reorder the columns by inserting the new columns after 'Carmax2022_online_Q1_open3'\n",
    "columns = list(filtered_data.columns)\n",
    "\n",
    "# Remove new columns from the list if they already exist (to prevent duplicates)\n",
    "columns = [col for col in columns if col not in new_columns]\n",
    "\n",
    "# Insert new columns at our desired posiiton\n",
    "for idx, col in enumerate(new_columns):\n",
    "    columns.insert(position + idx + 1, col)\n",
    "\n",
    "# Reorganize \n",
    "filtered_data = filtered_data[columns]\n",
    "\n",
    "# Restore the original columns (keeping NaN values intact)\n",
    "filtered_data.loc[:, columns_to_check] = original_columns\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "8c70640d-f607-48a2-a7d3-a7b8669ddac2",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Convert the 'starttime' and 'endtime' columns to datetime and format them to 'mm/dd/yyyy'\n",
    "filtered_data['starttime'] = pd.to_datetime(filtered_data['starttime']).dt.strftime('%m/%d/%Y')\n",
    "filtered_data['endtime'] = pd.to_datetime(filtered_data['endtime']).dt.strftime('%m/%d/%Y')\n",
    "\n",
    "# Save the updated DataFrame to a new Excel file\n",
    "filtered_data.to_excel('US26560581_CARMAX_2024-2025_Week of April 18 - 24,2025_Internal.xlsx', index=False)"
   ]
  },
